{
  "name": "code-squad-cli",
  "version": "1.0.8",
  "type": "module",
  "bin": {
    "csq": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --outfile=dist/index.js --allow-overwrite --external:@inquirer/core --external:@inquirer/prompts --external:chalk",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@inquirer/core": "^11.1.0",
    "@inquirer/prompts": "^7.2.1",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@code-squad/core": "workspace:*",
    "@types/node": "20.x",
    "esbuild": "^0.27.2",
    "rimraf": "^6.1.2",
    "typescript": "^5.3.0"
  }
}
