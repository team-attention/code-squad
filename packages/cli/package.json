{
  "name": "code-squad-cli",
  "version": "2.1.3",
  "type": "module",
  "bin": {
    "csq": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --outfile=dist/index.js --allow-overwrite --external:@inquirer/core --external:@inquirer/prompts --external:chalk --external:chokidar --external:express --external:cors --external:clipboardy --external:open --external:fast-glob --external:ink --external:react --external:react/jsx-runtime",
    "build:watch": "tsc --watch",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@inquirer/core": "^11.1.0",
    "@inquirer/prompts": "^7.2.1",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "clipboardy": "^4.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fast-glob": "^3.3.3",
    "ink": "^6.7.0",
    "open": "^10.0.3",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@code-squad/core": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "20.x",
    "@types/react": "^19.2.14",
    "esbuild": "^0.27.2",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
